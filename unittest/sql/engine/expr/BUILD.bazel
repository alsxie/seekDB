load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

# Each test source <name>.cpp builds into the test target <name>.
AI_FUNC_TESTS = [
    "ob_expr_ai_prompt_test",
    "test_ob_openai_utils",
]

[cc_library(
    name = name + "_cases",
    srcs = [
        name + ".cpp",
        "ob_expr_test_utils.h",
    ],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/sql:sql_unittest_headers",
    ],
) for name in AI_FUNC_TESTS]

[cc_test(
    name = name,
    size = "small",
    linkstatic = True,
    # liboceanbase supplies the C++ runtime; select rules_cc's $ORIGIN rpath.
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":" + name + "_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
) for name in AI_FUNC_TESTS]
