load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

# Sources go through the project cc_library so they share the oblib compile
# configuration (C++20, _GLIBCXX_USE_CXX11_ABI=1); cc_test / cc_binary only link.
_HIPVS_TEST_PLATFORMS = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_library(
    name = "hnswlib_stream_fixture",
    hdrs = ["hnswlib_stream_fixture.h"],
    includes = ["."],
)

cc_library(
    name = "hipvs_mock_plugin_objects",
    srcs = ["hipvs_mock_plugin.cpp"],
    alwayslink = True,
    deps = [
        ":hnswlib_stream_fixture",
        "//src/oblib:hipvs_builder_test_support",
    ],
    target_compatible_with = _HIPVS_TEST_PLATFORMS,
)

# GPU-free stand-in for libseekdb_hipvs.so used by test_hipvs_builder.
cc_binary(
    name = "libhipvs_mock_plugin.so",
    linkshared = True,
    deps = [":hipvs_mock_plugin_objects"],
    target_compatible_with = _HIPVS_TEST_PLATFORMS,
)

cc_library(
    name = "hipvs_builder_cases",
    srcs = ["test_hipvs_builder.cpp"],
    alwayslink = True,
    deps = [
        ":hnswlib_stream_fixture",
        "//src/oblib:hipvs_builder_test_support",
    ],
    target_compatible_with = _HIPVS_TEST_PLATFORMS,
)

cc_test(
    name = "test_hipvs_builder",
    args = ["$(rootpath :libhipvs_mock_plugin.so)"],
    data = [":libhipvs_mock_plugin.so"],
    linkstatic = True,
    deps = [":hipvs_builder_cases"],
    target_compatible_with = _HIPVS_TEST_PLATFORMS,
)

cc_library(
    name = "hnswlib_stream_cases",
    srcs = ["test_hnswlib_stream.cpp"],
    alwayslink = True,
    deps = [
        ":hnswlib_stream_fixture",
        "//src/oblib:hipvs_builder_test_support",
    ],
)

cc_test(
    name = "test_hnswlib_stream",
    linkstatic = True,
    deps = [":hnswlib_stream_cases"],
)

cc_library(
    name = "malloc_backend_cases",
    srcs = ["test_malloc_backend.cpp"],
    alwayslink = True,
    deps = [
        "//src/oblib:oblib_unit_test_internal_headers",
        "//bazel/third_party:gtest",
    ],
)

cc_test(
    name = "test_malloc_backend",
    linkstatic = True,
    deps = [":malloc_backend_cases", "//src/oblib:oblib_test_runtime"],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "jemalloc_hook_cases",
    srcs = ["test_jemalloc_hook.cpp"],
    alwayslink = True,
    deps = [
        "//src/oblib:oblib_unit_test_internal_headers",
        "//bazel/third_party:gtest",
    ],
    target_compatible_with = select({
        "//bazel:sanity_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_test(
    name = "test_jemalloc_hook",
    linkstatic = True,
    deps = [":jemalloc_hook_cases", "//src/oblib:oblib_test_runtime"],
)
