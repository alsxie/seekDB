load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

# GPU-free stand-in for libseekdb_hipvs.so used by test_hipvs_builder.
cc_binary(
    name = "libhipvs_mock_plugin.so",
    srcs = [
        "hipvs_mock_plugin.cpp",
        "hnswlib_stream_fixture.h",
    ],
    linkshared = True,
    deps = ["//src/oblib:hipvs_builder_test_support"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_test(
    name = "test_hipvs_builder",
    srcs = [
        "hnswlib_stream_fixture.h",
        "test_hipvs_builder.cpp",
    ],
    args = ["$(rootpath :libhipvs_mock_plugin.so)"],
    data = [":libhipvs_mock_plugin.so"],
    linkstatic = True,
    deps = ["//src/oblib:hipvs_builder_test_support"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_test(
    name = "test_hnswlib_stream",
    srcs = [
        "hnswlib_stream_fixture.h",
        "test_hnswlib_stream.cpp",
    ],
    linkstatic = True,
    deps = ["//src/oblib:hipvs_builder_test_support"],
)

cc_library(
    name = "malloc_backend_cases",
    srcs = ["test_malloc_backend.cpp"],
    alwayslink = True,
    deps = [
        "//src/oblib:oblib_unit_test_internal_headers",
        "//bazel/third_party:gtest",
    ],
)

cc_test(
    name = "test_malloc_backend",
    linkstatic = True,
    deps = [":malloc_backend_cases", "//src/oblib:oblib_test_runtime"],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "jemalloc_hook_cases",
    srcs = ["test_jemalloc_hook.cpp"],
    alwayslink = True,
    deps = [
        "//src/oblib:oblib_unit_test_internal_headers",
        "//bazel/third_party:gtest",
    ],
    target_compatible_with = select({
        "//bazel:sanity_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_test(
    name = "test_jemalloc_hook",
    linkstatic = True,
    deps = [":jemalloc_hook_cases", "//src/oblib:oblib_test_runtime"],
)
