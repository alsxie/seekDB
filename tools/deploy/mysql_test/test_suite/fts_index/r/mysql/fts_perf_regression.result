create table words(
  id int primary key,
  w varchar(64),
  b varbinary(64),
  body varchar(512)) default charset utf8mb4 collate utf8mb4_general_ci;
create fulltext index ft_words on words(body) with parser beng;
create fulltext index ft_words_ik on words(w, body) with parser ik;
create index idx_w_b on words(w, b);
create index idx_b_w on words(b, w);
select count(*), sum(id) from words where match(body) against('resume');
